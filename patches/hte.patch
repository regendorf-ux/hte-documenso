@@ -0,0 +1,71 @@
+/**
+ * HTE, Inc.'s pieces for its copy of Documenso: the logo, the logo's sphere (phones), the
+ * light / dark switch, and the "Powered by Documenso" line.
+ * Styles are in app/hte.css.
+ */
+import { useIsMounted } from '@documenso/lib/client-only/hooks/use-is-mounted';
+import { cn } from '@documenso/ui/lib/utils';
+import { MoonStar, Sun } from 'lucide-react';
+import type { ImgHTMLAttributes } from 'react';
+import { Theme, useTheme } from 'remix-themes';
+
+/** Where this copy's source is published (the AGPL's offer of the source). */
+export const HTE_SOURCE_URL = 'https://github.com/regendorf-ux/hte-documenso';
+
+type ImgProps = ImgHTMLAttributes<HTMLImageElement>;
+
+export const HteLogo = ({ className, ...props }: ImgProps) => (
+  <img src="/hte/logo.png" alt="HTE, Inc." className={cn('hte-logo', className)} {...props} />
+);
+
+export const HteMark = ({ className, ...props }: ImgProps) => (
+  <img src="/hte/mark.png" alt="HTE, Inc." className={cn('hte-mark', className)} {...props} />
+);
+
+/**
+ * Light or dark. Until someone picks, the page follows the device (light or dark); a pick is
+ * remembered (Documenso's own theme cookie). Two buttons, no third "as the device" one.
+ */
+export const HteThemeSwitch = ({ className, small = false }: { className?: string; small?: boolean }) => {
+  const [theme, setTheme] = useTheme();
+  const isMounted = useIsMounted();
+
+  const deviceDark = isMounted && window.matchMedia('(prefers-color-scheme: dark)').matches;
+  const shown = theme ?? (deviceDark ? Theme.DARK : Theme.LIGHT);
+
+  return (
+    <div className={cn('hte-theme', small && 'hte-small', className)}>
+      <div className="hte-theme-pill">
+        <button
+          type="button"
+          title="Light"
+          aria-label="Light"
+          aria-pressed={isMounted && shown === Theme.LIGHT}
+          className={cn(isMounted && shown === Theme.LIGHT && 'on')}
+          onClick={() => setTheme(Theme.LIGHT)}
+        >
+          <Sun />
+        </button>
+        <button
+          type="button"
+          title="Dark"
+          aria-label="Dark"
+          aria-pressed={isMounted && shown === Theme.DARK}
+          className={cn(isMounted && shown === Theme.DARK && 'on')}
+          onClick={() => setTheme(Theme.DARK)}
+        >
+          <MoonStar />
+        </button>
+      </div>
+    </div>
+  );
+};
+
+export const HtePoweredBy = () => (
+  <div className="hte-powered">
+    HTE Document Signing · Powered by <b>Documenso</b> ·{' '}
+    <a href={HTE_SOURCE_URL} target="_blank" rel="noopener">
+      source
+    </a>
+  </div>
+);
