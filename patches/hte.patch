@@ -0,0 +1,391 @@
+/*
+ * HTE, Inc.'s look for Documenso (sign.htepr.com). Loaded after Documenso's own theme.css,
+ * so it only re-sets values: buttons and accents in the logo's blue (the CSR app's #0a66e8,
+ * #3b8dff in dark), a navy top bar, htepr.com's type (Archivo headings, Source Sans 3 text),
+ * the HTE sign-in card and the "Powered by Documenso" line. Light and dark follow the
+ * device until someone picks one with the switch in the top bar.
+ */
+
+@font-face {
+  font-family: "Archivo";
+  font-weight: 600;
+  font-display: swap;
+  src: url("/hte/fonts/archivo-600.woff2") format("woff2");
+}
+@font-face {
+  font-family: "Archivo";
+  font-weight: 700;
+  font-display: swap;
+  src: url("/hte/fonts/archivo-700.woff2") format("woff2");
+}
+@font-face {
+  font-family: "Source Sans 3";
+  font-weight: 400;
+  font-display: swap;
+  src: url("/hte/fonts/source-sans-3-400.woff2") format("woff2");
+}
+@font-face {
+  font-family: "Source Sans 3";
+  font-weight: 600;
+  font-display: swap;
+  src: url("/hte/fonts/source-sans-3-600.woff2") format("woff2");
+}
+
+:root,
+.dark-mode-disabled {
+  --font-sans: "Source Sans 3";
+  --foreground: 240 3% 12%;
+  --primary: 215 92% 47%;
+  --primary-foreground: 0 0% 100%;
+  --ring: 215 92% 47%;
+  --field-card: 215 92% 95%;
+  --field-card-border: 215 85% 62%;
+  --card-border-tint: 10 102 232;
+  --documenso: #0a66e8;
+  --new-primary-50: 215, 92%, 97%;
+  --new-primary-100: 215, 92%, 93%;
+  --new-primary-200: 215, 92%, 85%;
+  --new-primary-300: 215, 90%, 72%;
+  --new-primary-400: 215, 90%, 60%;
+  --new-primary-500: 215, 92%, 47%;
+  --new-primary-600: 215, 92%, 40%;
+  --new-primary-700: 215, 92%, 33%;
+  --new-primary-800: 215, 92%, 24%;
+  --new-primary-900: 215, 92%, 14%;
+  --new-primary-950: 215, 92%, 8%;
+  --envelope-editor-background: 240 5% 96%;
+
+  --hte-navy: #0a2540;
+  --hte-blue: #0a66e8;
+  --hte-link: #0854c0;
+  --hte-quiet: #6e6e73;
+  --hte-line: #d8dee3;
+  --hte-footer: rgba(255, 255, 255, 0.94);
+  --hte-card: #ffffff;
+  --hte-card-ink: #101519;
+  --hte-on-blue: #ffffff;
+}
+
+/* Dark: the CSR app's dark palette. Same selector shape as Documenso's dark rule, one step stronger. */
+html.dark:not(.dark-mode-disabled),
+html.dark .dark-mode-disabled {
+  --background: 240 3% 11%;
+  --foreground: 240 20% 96%;
+  --card: 240 4% 15%;
+  --card-foreground: 240 20% 96%;
+  --card-border: 240 3% 24%;
+  --popover: 240 4% 15%;
+  --popover-foreground: 240 20% 96%;
+  --widget: 240 4% 15%;
+  --widget-foreground: 240 3% 20%;
+  --muted: 240 3% 19%;
+  --muted-foreground: 240 3% 66%;
+  --border: 240 3% 24%;
+  --input: 240 3% 28%;
+  --field-border: 240 3% 40%;
+  --secondary: 240 3% 19%;
+  --secondary-foreground: 240 20% 96%;
+  --accent: 240 3% 21%;
+  --accent-foreground: 240 20% 96%;
+  --primary: 215 100% 62%;
+  --primary-foreground: 216 65% 12%;
+  --ring: 215 100% 62%;
+  --field-card: 215 60% 18%;
+  --field-card-border: 215 100% 62%;
+  --field-card-foreground: 240 20% 96%;
+  --envelope-editor-background: 240 3% 11%;
+  --documenso: #3b8dff;
+
+  --hte-blue: #3b8dff;
+  --hte-link: #5ea1ff;
+  --hte-quiet: #a1a1a8;
+  --hte-line: #3a3a3e;
+  --hte-footer: rgba(28, 28, 30, 0.94);
+  --hte-card: #242427;
+  --hte-card-ink: #f2f2f7;
+  --hte-on-blue: #0b1b33;
+  color-scheme: dark;
+}
+
+body {
+  font-family: "Source Sans 3", "Inter", system-ui, sans-serif;
+}
+h1,
+h2,
+h3,
+[role="dialog"] h2 {
+  font-family: "Archivo", system-ui, sans-serif;
+  letter-spacing: -0.01em;
+}
+button {
+  font-family: "Archivo", system-ui, sans-serif;
+  font-weight: 600;
+}
+
+/* Documenso's green links and the green glow behind "Document Signed". */
+[class*="text-documenso-"],
+.text-documenso {
+  color: var(--hte-link) !important;
+}
+[class*="border-documenso"] {
