+}
+.hte-signin .hte-signin-logo {
+  width: 220px;
+  margin: 0 auto;
+  border-radius: 8px;
+  padding: 4px 10px;
+  background: #fff;
+}
+.hte-signin .hte-hint {
+  color: var(--hte-quiet);
+  font-size: 15px;
+  line-height: 1.45;
+}
+.hte-signin .hte-other {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--hte-link);
+  background: none;
+  border: 0;
+  cursor: pointer;
+}
+.hte-signin .hte-switch {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+}
+.hte-signin .hte-switch > div {
+  background: hsl(var(--muted));
+}
+.hte-ms {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  height: 48px;
+  padding: 0 22px;
+  border: 0;
+  border-radius: 6px;
+  cursor: pointer;
+  background: var(--hte-blue);
+  color: var(--hte-on-blue);
+  font-size: 16px;
+}
+.hte-ms:hover {
+  filter: brightness(1.08);
+}
+.hte-ms-logo {
+  width: 18px;
+  height: 18px;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 2px;
+}
+.hte-ms-logo i:nth-child(1) {
+  background: #f25022;
+}
+.hte-ms-logo i:nth-child(2) {
+  background: #7fba00;
+}
+.hte-ms-logo i:nth-child(3) {
+  background: #00a4ef;
+}
+.hte-ms-logo i:nth-child(4) {
+  background: #ffb900;
+}
+.hte-signin form {
+  text-align: left;
+}
