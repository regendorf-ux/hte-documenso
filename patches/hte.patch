diff --git a/apps/remix/app/components/general/envelope-signing/hte-quick-sign.tsx b/apps/remix/app/components/general/envelope-signing/hte-quick-sign.tsx
new file mode 100644
index 0000000..0a046f9
--- /dev/null
+++ b/apps/remix/app/components/general/envelope-signing/hte-quick-sign.tsx
@@ -0,0 +1,193 @@
+/**
+ * HTE, Inc.: fewer steps for a signer with one signature left (and perhaps name, date or e-mail boxes,
+ * which "Sign and finish" fills with the values a tap on them would).
+ *
+ * - The main button reads "Sign as <name>" instead of "Next Field": it brings the field into view
+ *   and opens the signature window, whose button reads "Sign and finish".
+ * - "Sign and finish" signs the field and completes the signer's part at once: no "Complete"
+ *   button and no second "Are you sure?" window. The consent text stays in the signature window,
+ *   where the person signs.
+ * - An embed that asks for it (`openSignature` in the embed's data) opens that window by itself once
+ *   the page has loaded, typed signature first when it also asks for `preferTypedSignature`. The
+ *   service-report app asks this for its own technician only; a customer always sees the document
+ *   first and presses the button.
+ *
+ * Anything else (several fields left, two-factor completion, TSP signing, direct templates,
+ * approvers and viewers) keeps Documenso's own flow.
+ */
+import { AppError } from '@documenso/lib/errors/app-error';
+import type { TRecipientAccessAuth } from '@documenso/lib/types/document-auth';
+import { isTspEnvelope } from '@documenso/lib/types/signature-level';
+import { Button } from '@documenso/ui/primitives/button';
+import { useToast } from '@documenso/ui/primitives/use-toast';
+import { Trans, useLingui } from '@lingui/react/macro';
+import { FieldType, RecipientRole } from '@prisma/client';
+import { useEffect, useRef, useState } from 'react';
+
+import { SignFieldSignatureDialog } from '~/components/dialogs/sign-field-signature-dialog';
+import { getSigningCompletionErrorMessage } from '~/utils/toast-error-messages';
+
+import { useRequiredDocumentSigningAuthContext } from '../document-signing/document-signing-auth-provider';
+import { useRequiredEnvelopeSigningContext } from '../document-signing/envelope-signing-provider';
+
+type HteWindow = { __htePreferTypedSignature?: boolean; __hteOpenSignature?: boolean };
+
+const hteWindow = () => (typeof window === 'undefined' ? {} : (window as unknown as HteWindow));
+
+/** Read by the embed pages when they parse their data (embed-document-signing-page-v1/v2.tsx). */
+export const hteRememberEmbedData = (data: { preferTypedSignature?: boolean; openSignature?: boolean }) => {
+  if (typeof window === 'undefined') {
+    return;
+  }
+
+  if (data.preferTypedSignature) {
+    hteWindow().__htePreferTypedSignature = true;
+  }
+
+  if (data.openSignature) {
+    hteWindow().__hteOpenSignature = true;
+  }
+};
+
+/** Read by the signature pad when it opens (signature-pad.tsx). */
+export const htePrefersTypedSignature = () => Boolean(hteWindow().__htePreferTypedSignature);
+
+// The button is drawn twice (the header and the phone's bottom bar): open the window once per page.
+const autoOpened = new Set<string>();
+
+type HteQuickSignProps = {
+  onNextField: () => void;
+  onComplete: (nextSigner?: { name: string; email: string }, accessAuthOptions?: TRecipientAccessAuth) => Promise<void>;
+  isSubmitting: boolean;
+};
+
+// Boxes a tap fills with what Documenso already knows (the signer's name and e-mail, today's date): "Sign and
+// finish" fills them as those taps would, so a signer with a name box and a date box still signs in one go.
+const FILLED_FOR_THEM: FieldType[] = [FieldType.NAME, FieldType.DATE, FieldType.EMAIL];
+
+/** The one signature this signer may sign-and-finish, and the boxes filled with it; null for Documenso's own flow. */
+export const useHteQuickSignField = () => {
+  const { envelope, recipient, recipientFieldsRemaining, isDirectTemplate, fullName } =
+    useRequiredEnvelopeSigningContext();
+  const { derivedRecipientAccessAuth } = useRequiredDocumentSigningAuthContext();
+
+  const signatures = recipientFieldsRemaining.filter((field) => field.type === FieldType.SIGNATURE);
+  const fill = recipientFieldsRemaining.filter((field) => field.type !== FieldType.SIGNATURE);
+
+  if (
+    isDirectTemplate ||
+    recipient.role !== RecipientRole.SIGNER ||
+    isTspEnvelope(envelope) ||
+    !recipient.email ||
+    !(recipient.name || fullName) ||
+    derivedRecipientAccessAuth.includes('TWO_FACTOR_AUTH') ||
+    signatures.length !== 1 ||
+    !fill.every((field) => FILLED_FOR_THEM.includes(field.type))
+  ) {
+    return null;
+  }
+
+  return { signature: signatures[0], fill };
+};
+
+export const HteQuickSignButton = ({ onNextField, onComplete, isSubmitting }: HteQuickSignProps) => {
+  const { t, i18n } = useLingui();
+  const { toast } = useToast();
+
+  const { envelope, recipient, fullName, signature, setSignature, signField } = useRequiredEnvelopeSigningContext();
+  const { executeActionAuthProcedure } = useRequiredDocumentSigningAuthContext();
+
+  const quick = useHteQuickSignField();
+  const field = quick?.signature;
+  const [isWorking, setIsWorking] = useState(false);
+  const running = useRef(false);
+
+  const name = recipient.name || fullName;
+
+  const run = async () => {
+    if (!field || running.current) {
+      return;
+    }
+
+    running.current = true;
+    onNextField();
+
+    try {
+      const value = await SignFieldSignatureDialog.call({
+        fullName: name,
+        initialSignature: signature ?? undefined,
+        typedSignatureEnabled: envelope.documentMeta.typedSignatureEnabled,
+        uploadSignatureEnabled: envelope.documentMeta.uploadSignatureEnabled,
+        drawSignatureEnabled: envelope.documentMeta.drawSignatureEnabled,
+        hteTitle: name ? t`Sign as ${name}` : undefined,
+        hteSignLabel: t`Sign and finish`,
+      });
+
+      if (!value) {
+        return;
+      }
+
+      setIsWorking(true);
+
+      // The name, date and e-mail boxes, with the values a tap on each would put in.
+      for (const box of quick?.fill ?? []) {
+        if (box.type === FieldType.NAME) {
+          await signField(box.id, { type: FieldType.NAME, value: name });
+        } else if (box.type === FieldType.DATE) {
+          await signField(box.id, { type: FieldType.DATE, value: true });
+        } else if (box.type === FieldType.EMAIL) {
+          await signField(box.id, { type: FieldType.EMAIL, value: recipient.email });
+        }
+      }
+
+      await executeActionAuthProcedure({
+        actionTarget: FieldType.SIGNATURE,
+        onReauthFormSubmit: async (authOptions) => {
+          await signField(field.id, { type: FieldType.SIGNATURE, value }, authOptions);
+        },
+      });
+
+      setSignature(value);
+
+      await onComplete(undefined, undefined);
+    } catch (error) {
+      const err = AppError.parseError(error);
+      const message = getSigningCompletionErrorMessage(err.code);
+
+      toast({ title: i18n._(message.title), description: i18n._(message.description), variant: 'destructive' });
+    } finally {
+      running.current = false;
+      setIsWorking(false);
+    }
+  };
+
+  useEffect(() => {
+    if (!field || autoOpened.has(recipient.token)) {
+      return;
+    }
+
+    // The embed reads its data after this mounts: look once the page has settled.
+    const timer = setTimeout(() => {
+      if (hteWindow().__hteOpenSignature && !autoOpened.has(recipient.token)) {
+        autoOpened.add(recipient.token);
+        void run();
+      }
+    }, 800);
+
+    return () => clearTimeout(timer);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [field?.id, recipient.token]);
+
+  return (
+    <Button
+      className="w-full"
+      type="button"
+      size="sm"
+      loading={isSubmitting || isWorking}
+      disabled={!field}
+      onClick={() => void run()}
+    >
+      {name ? <Trans>Sign as {name}</Trans> : <Trans>Sign</Trans>}
+    </Button>
+  );
+};
