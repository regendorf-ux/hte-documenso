diff --git a/apps/remix/app/components/general/hte.tsx b/apps/remix/app/components/general/hte.tsx
new file mode 100644
index 0000000..b29c798
--- /dev/null
+++ b/apps/remix/app/components/general/hte.tsx
@@ -0,0 +1,71 @@
+/**
+ * HTE, Inc.'s pieces for its copy of Documenso: the logo, the logo's sphere (phones), the
+ * light / dark switch, and the "Powered by Documenso" line.
+ * Styles are in app/hte.css.
+ */
+import { useIsMounted } from '@documenso/lib/client-only/hooks/use-is-mounted';
+import { cn } from '@documenso/ui/lib/utils';
+import { MoonStar, Sun } from 'lucide-react';
+import type { ImgHTMLAttributes } from 'react';
+import { Theme, useTheme } from 'remix-themes';
+
+/** Where this copy's source is published (the AGPL's offer of the source). */
+export const HTE_SOURCE_URL = 'https://github.com/regendorf-ux/hte-documenso';
+
+type ImgProps = ImgHTMLAttributes<HTMLImageElement>;
+
+export const HteLogo = ({ className, ...props }: ImgProps) => (
+  <img src="/hte/logo.png" alt="HTE, Inc." className={cn('hte-logo', className)} {...props} />
+);
+
+export const HteMark = ({ className, ...props }: ImgProps) => (
+  <img src="/hte/mark.png" alt="HTE, Inc." className={cn('hte-mark', className)} {...props} />
+);
+
+/**
+ * Light or dark. Until someone picks, the page follows the device (light or dark); a pick is
+ * remembered (Documenso's own theme cookie). Two buttons, no third "as the device" one.
+ */
+export const HteThemeSwitch = ({ className, small = false }: { className?: string; small?: boolean }) => {
+  const [theme, setTheme] = useTheme();
+  const isMounted = useIsMounted();
+
+  const deviceDark = isMounted && window.matchMedia('(prefers-color-scheme: dark)').matches;
+  const shown = theme ?? (deviceDark ? Theme.DARK : Theme.LIGHT);
+
+  return (
+    <div className={cn('hte-theme', small && 'hte-small', className)}>
+      <div className="hte-theme-pill">
+        <button
+          type="button"
+          title="Light"
+          aria-label="Light"
+          aria-pressed={isMounted && shown === Theme.LIGHT}
+          className={cn(isMounted && shown === Theme.LIGHT && 'on')}
+          onClick={() => setTheme(Theme.LIGHT)}
+        >
+          <Sun />
+        </button>
+        <button
+          type="button"
+          title="Dark"
+          aria-label="Dark"
+          aria-pressed={isMounted && shown === Theme.DARK}
+          className={cn(isMounted && shown === Theme.DARK && 'on')}
+          onClick={() => setTheme(Theme.DARK)}
+        >
+          <MoonStar />
+        </button>
+      </div>
+    </div>
+  );
+};
+
+export const HtePoweredBy = () => (
+  <div className="hte-powered">
+    HTE Document Signing · Powered by <b>Documenso</b> ·{' '}
+    <a href={HTE_SOURCE_URL} target="_blank" rel="noopener">
+      source
+    </a>
+  </div>
+);
diff --git a/apps/remix/app/hte.css b/apps/remix/app/hte.css
new file mode 100644
index 0000000..4ade6f3
--- /dev/null
+++ b/apps/remix/app/hte.css
@@ -0,0 +1,391 @@
+/*
+ * HTE, Inc.'s look for Documenso (sign.htepr.com). Loaded after Documenso's own theme.css,
+ * so it only re-sets values: buttons and accents in the logo's blue (the CSR app's #0a66e8,
+ * #3b8dff in dark), a navy top bar, htepr.com's type (Archivo headings, Source Sans 3 text),
+ * the HTE sign-in card and the "Powered by Documenso" line. Light and dark follow the
+ * device until someone picks one with the switch in the top bar.
+ */
+
+@font-face {
+  font-family: "Archivo";
+  font-weight: 600;
+  font-display: swap;
+  src: url("/hte/fonts/archivo-600.woff2") format("woff2");
+}
+@font-face {
+  font-family: "Archivo";
+  font-weight: 700;
+  font-display: swap;
+  src: url("/hte/fonts/archivo-700.woff2") format("woff2");
+}
+@font-face {
+  font-family: "Source Sans 3";
+  font-weight: 400;
+  font-display: swap;
+  src: url("/hte/fonts/source-sans-3-400.woff2") format("woff2");
+}
+@font-face {
+  font-family: "Source Sans 3";
+  font-weight: 600;
+  font-display: swap;
+  src: url("/hte/fonts/source-sans-3-600.woff2") format("woff2");
+}
+
+:root,
+.dark-mode-disabled {
+  --font-sans: "Source Sans 3";
+  --foreground: 240 3% 12%;
+  --primary: 215 92% 47%;
+  --primary-foreground: 0 0% 100%;
+  --ring: 215 92% 47%;
+  --field-card: 215 92% 95%;
+  --field-card-border: 215 85% 62%;
+  --card-border-tint: 10 102 232;
+  --documenso: #0a66e8;
+  --new-primary-50: 215, 92%, 97%;
+  --new-primary-100: 215, 92%, 93%;
+  --new-primary-200: 215, 92%, 85%;
+  --new-primary-300: 215, 90%, 72%;
+  --new-primary-400: 215, 90%, 60%;
+  --new-primary-500: 215, 92%, 47%;
+  --new-primary-600: 215, 92%, 40%;
+  --new-primary-700: 215, 92%, 33%;
+  --new-primary-800: 215, 92%, 24%;
+  --new-primary-900: 215, 92%, 14%;
+  --new-primary-950: 215, 92%, 8%;
+  --envelope-editor-background: 240 5% 96%;
+
+  --hte-navy: #0a2540;
+  --hte-blue: #0a66e8;
+  --hte-link: #0854c0;
+  --hte-quiet: #6e6e73;
+  --hte-line: #d8dee3;
+  --hte-footer: rgba(255, 255, 255, 0.94);
+  --hte-card: #ffffff;
+  --hte-card-ink: #101519;
+  --hte-on-blue: #ffffff;
+}
+
+/* Dark: the CSR app's dark palette. Same selector shape as Documenso's dark rule, one step stronger. */
+html.dark:not(.dark-mode-disabled),
+html.dark .dark-mode-disabled {
+  --background: 240 3% 11%;
+  --foreground: 240 20% 96%;
+  --card: 240 4% 15%;
+  --card-foreground: 240 20% 96%;
+  --card-border: 240 3% 24%;
+  --popover: 240 4% 15%;
+  --popover-foreground: 240 20% 96%;
+  --widget: 240 4% 15%;
+  --widget-foreground: 240 3% 20%;
+  --muted: 240 3% 19%;
+  --muted-foreground: 240 3% 66%;
+  --border: 240 3% 24%;
+  --input: 240 3% 28%;
+  --field-border: 240 3% 40%;
+  --secondary: 240 3% 19%;
+  --secondary-foreground: 240 20% 96%;
+  --accent: 240 3% 21%;
+  --accent-foreground: 240 20% 96%;
+  --primary: 215 100% 62%;
+  --primary-foreground: 216 65% 12%;
+  --ring: 215 100% 62%;
+  --field-card: 215 60% 18%;
+  --field-card-border: 215 100% 62%;
+  --field-card-foreground: 240 20% 96%;
+  --envelope-editor-background: 240 3% 11%;
+  --documenso: #3b8dff;
+
+  --hte-blue: #3b8dff;
+  --hte-link: #5ea1ff;
+  --hte-quiet: #a1a1a8;
+  --hte-line: #3a3a3e;
+  --hte-footer: rgba(28, 28, 30, 0.94);
+  --hte-card: #242427;
+  --hte-card-ink: #f2f2f7;
+  --hte-on-blue: #0b1b33;
+  color-scheme: dark;
+}
+
+body {
+  font-family: "Source Sans 3", "Inter", system-ui, sans-serif;
+}
+h1,
+h2,
+h3,
+[role="dialog"] h2 {
+  font-family: "Archivo", system-ui, sans-serif;
+  letter-spacing: -0.01em;
+}
+button {
+  font-family: "Archivo", system-ui, sans-serif;
+  font-weight: 600;
+}
+
+/* Documenso's green links and the green glow behind "Document Signed". */
+[class*="text-documenso-"],
+.text-documenso {
+  color: var(--hte-link) !important;
+}
+[class*="border-documenso"] {
+  border-color: var(--hte-blue) !important;
+}
+/* Buttons that switch to Documenso's fixed green in dark mode (the sign-in button, for one). */
+html.dark .dark\:bg-documenso {
+  background-color: hsl(var(--primary)) !important;
+  color: hsl(var(--primary-foreground)) !important;
+}
+img[src*="signing-celebration"] {
+  filter: hue-rotate(115deg) saturate(0.8);
+}
+html.dark img[src*="signing-celebration"] {
+  filter: invert(1) hue-rotate(295deg) saturate(0.6) brightness(0.7);
+}
+
+/* The logo: its grey lettering needs its white, so on the navy bar it sits on a white tile. */
+img.hte-logo {
+  width: auto;
+}
+img.hte-mark {
+  width: auto;
+}
+.hte-bar img.hte-logo {
+  height: 44px;
+  background: #fff;
+  padding: 3px 10px;
+  border-radius: 4px;
+}
+.hte-bar img.hte-mark {
+  height: 32px;
+  background: #fff;
+  padding: 2px;
+  border-radius: 6px;
+}
+
+/* The navy top bar (header option B): the app's header, the signing pages', the editor's. */
+.hte-bar {
+  background: var(--hte-navy) !important;
+  border-bottom-color: transparent !important;
+  color: #f6f7f8;
+}
+.hte-bar a,
+.hte-bar button,
+.hte-bar p,
+.hte-bar h1,
+.hte-bar span:not(.hte-keep) {
+  color: #f6f7f8;
+}
+.hte-bar .text-muted-foreground,
+.hte-bar .text-muted-foreground * {
+  color: #b7c4d3 !important;
+}
+.hte-bar .text-foreground {
+  color: #f6f7f8 !important;
+}
+/* Light chips in the bar (an avatar's letter, the search box's shortcut) keep dark text. */
+.hte-bar .bg-muted,
+.hte-bar .bg-muted * {
+  color: #4b5563 !important;
+}
+html.dark .hte-bar .bg-muted,
+html.dark .hte-bar .bg-muted * {
+  color: #c7c7cc !important;
+}
+.hte-bar input,
+.hte-bar button.border,
+.hte-bar a.border,
+.hte-bar [class*="border-input"] {
+  background: rgba(255, 255, 255, 0.08) !important;
+  border-color: rgba(255, 255, 255, 0.25) !important;
+}
+.hte-bar .bg-primary,
+.hte-bar .bg-primary * {
+  color: hsl(var(--primary-foreground)) !important;
+}
+.hte-bar [data-orientation="vertical"][role="none"],
+.hte-bar .bg-border {
+  background: rgba(255, 255, 255, 0.25) !important;
+}
+
+/* The light / dark switch: two round buttons in a pill, the chosen one filled. */
+.hte-theme-pill {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  padding: 3px;
+  border-radius: 999px;
+  background: hsl(var(--muted));
+}
+.hte-theme-pill button {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 2rem;
+  height: 2rem;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: hsl(var(--muted-foreground));
+  cursor: pointer;
+}
+.hte-theme-pill button svg {
+  width: 1.15rem;
+  height: 1.15rem;
+}
+.hte-theme-pill button.on {
+  background: hsl(var(--background));
+  color: hsl(var(--foreground));
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
+}
+.hte-small .hte-theme-pill button {
+  width: 1.75rem;
+  height: 1.75rem;
+}
+.hte-small .hte-theme-pill button svg {
+  width: 1rem;
+  height: 1rem;
+}
+.hte-bar .hte-theme-pill {
+  background: rgba(255, 255, 255, 0.1);
+}
+.hte-bar .hte-theme-pill button {
+  color: #b7c4d3 !important;
+}
+.hte-bar .hte-theme-pill button.on {
+  background: rgba(255, 255, 255, 0.22);
+  color: #ffffff !important;
+  box-shadow: none;
+}
+
+/* "Powered by Documenso · source": at the foot of every page; fixed to the window's bottom on a computer. */
+.hte-powered {
+  text-align: center;
+  padding: 6px 12px;
+  font:
+    400 12.5px / 1.4 "Source Sans 3",
+    system-ui,
+    sans-serif;
+  color: var(--hte-quiet);
+}
+.hte-powered b {
+  font-weight: 600;
+}
+.hte-powered a {
+  text-decoration: underline;
+  color: inherit;
+}
+@media (min-width: 768px) {
+  .hte-powered {
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 40;
+    background: var(--hte-footer);
+    border-top: 1px solid var(--hte-line);
+  }
+  body:has(.hte-powered) {
+    padding-bottom: 30px;
+  }
+}
+
+/* Sign-in (option B2): the HTE photo under navy, one card. */
+.hte-photo {
+  background:
+    linear-gradient(rgba(10, 37, 64, 0.82), rgba(10, 37, 64, 0.82)),
+    url("/hte/backdrop.webp") center / cover;
+}
+html.dark .hte-photo {
+  background:
+    linear-gradient(rgba(12, 14, 18, 0.86), rgba(12, 14, 18, 0.86)),
+    url("/hte/backdrop.webp") center / cover;
+}
+.hte-photo footer,
+.hte-photo footer a {
+  color: #b9c6d4;
+}
+.hte-signin {
+  position: relative;
+  width: min(440px, 100%);
+  padding: 40px 36px;
+  border-radius: 10px;
+  background: var(--hte-card);
+  color: var(--hte-card-ink);
+  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  align-items: stretch;
+  text-align: center;
+}
+.hte-signin h1 {
+  font-size: 26px;
+  font-weight: 700;
+}
+.hte-signin .hte-signin-logo {
+  width: 220px;
+  margin: 0 auto;
+  border-radius: 8px;
+  padding: 4px 10px;
+  background: #fff;
+}
+.hte-signin .hte-hint {
+  color: var(--hte-quiet);
+  font-size: 15px;
+  line-height: 1.45;
+}
+.hte-signin .hte-other {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--hte-link);
+  background: none;
+  border: 0;
+  cursor: pointer;
+}
+.hte-signin .hte-switch {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+}
+.hte-signin .hte-switch > div {
+  background: hsl(var(--muted));
+}
+.hte-ms {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  height: 48px;
+  padding: 0 22px;
+  border: 0;
+  border-radius: 6px;
+  cursor: pointer;
+  background: var(--hte-blue);
+  color: var(--hte-on-blue);
+  font-size: 16px;
+}
+.hte-ms:hover {
+  filter: brightness(1.08);
+}
+.hte-ms-logo {
+  width: 18px;
+  height: 18px;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 2px;
+}
+.hte-ms-logo i:nth-child(1) {
+  background: #f25022;
+}
+.hte-ms-logo i:nth-child(2) {
+  background: #7fba00;
+}
+.hte-ms-logo i:nth-child(3) {
+  background: #00a4ef;
+}
+.hte-ms-logo i:nth-child(4) {
+  background: #ffb900;
+}
+.hte-signin form {
+  text-align: left;
+}
