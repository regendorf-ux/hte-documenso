+  color: #f6f7f8;
+}
+.hte-bar .text-muted-foreground,
+.hte-bar .text-muted-foreground * {
+  color: #b7c4d3 !important;
+}
+.hte-bar .text-foreground {
+  color: #f6f7f8 !important;
+}
+/* Light chips in the bar (an avatar's letter, the search box's shortcut) keep dark text. */
+.hte-bar .bg-muted,
